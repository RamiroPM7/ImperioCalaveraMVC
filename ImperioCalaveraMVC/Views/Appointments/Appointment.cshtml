@using static ImperioCalaveraMVC.Models.Enums.Enums

<script>
    // This passes the user's role from the server to a JavaScript variable
    window.currentUserRole = "@(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Barbero") ? "Barbero" : "Cliente")";

    window.appointmentsData = @Html.Raw(Json.Serialize(Model.Appointments));
</script>


@{
    ViewData["Title"] = "Appointments";
    Layout = "_Layout";
}

@model PaginatedAppointmentsViewModel

<section id="appointment-section" class="py-5">
    <div class="container">
        <div id="message-container"></div>  <!-- This is where alerts will insert -->
        @{
            var activeTab = ViewData["ActiveTab"] as string ?? "agendar";
        }

        <ul class="nav nav-tabs mb-4" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "agendar" ? "active" : "")" id="book-tab" data-bs-toggle="tab" data-bs-target="#book-appointment" type="button" role="tab">
                    Agendar Cita
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link @(activeTab == "citas" ? "active" : "")" asp-action="Appointment" asp-route-tab="citas" id="my-tab">
                    Mis Citas
                </a>
            </li>
        </ul>

        <div class="tab-content" id="myTabContent">
            <!-- Pestaña para Agendar Cita -->
            <div class="tab-pane fade @(activeTab == "agendar" ? "show active" : "")" id="book-appointment" role="tabpanel">
                <div class="card p-4 shadow">
                    <div id="calendar"></div> <!-- Contenedor para FullCalendar -->
                </div>

                <div class="card p-4 mt-4 shadow">
                    <h5 class="mb-3">Selecciona una hora</h5>
                    <div id="time-slots-container" class="d-flex flex-wrap" style="gap: 15px;">
                        <!-- Tarjetas de hora se generarán aquí -->
                    </div>
                </div>

                @if (User.IsInRole("Admin") || User.IsInRole("Barbero"))
                {
                    <div class="card p-4 mt-4 shadow bg-light">
                        <h5 class="mb-3"><i class="bi bi-person-plus-fill"></i> Registrar Cliente</h5>
                        <p class="text-muted small">Aquí puedes registrar clientes manualmente.</p>
                        <div class="mb-3">
                            <label for="walk-in-customer-name" class="form-label">Nombre del Cliente</label>
                            <input type="text" class="form-control" id="walk-in-customer-name" placeholder="Ej. Juan Pérez" required>
                        </div>

                        <div class="mb-3">
                            <label for="walk-in-customer-phone" class="form-label">Teléfono del Cliente</label>
                            <input type="tel" class="form-control" id="walk-in-customer-phone" placeholder="Ej. 452 123 4567" required>
                        </div>

                        <div class="mb-3">
                            <label for="walk-in-customer-notes" class="form-label">Notas Adicionales</label>
                            <textarea class="form-control" id="walk-in-customer-notes" rows="2" placeholder="Notas sobre el servicio."></textarea>
                        </div>
                    </div>
                }

                <div class="text-center mt-4">
                    <button id="agendar-cita-btn" class="btn btn-primary btn-lg">Agendar Cita</button>
                </div>
            </div>

            <div class="tab-pane fade @(activeTab == "citas" ? "show active" : "")" id="my-appointments" role="tabpanel">

                <div class="d-flex justify-content-end mb-3">
                    <div class="btn-group" role="group" aria-label="Selector de vista">

                        <button type="button" class="btn btn-primary" id="btn-view-cards">
                            <i class="bi bi-grid-fill"></i> Tarjetas
                        </button>

                        <button type="button" class="btn btn-outline-primary" id="btn-view-table">
                            <i class="bi bi-list-ul"></i> Tabla
                        </button>

                    </div>
                </div>

                <div id="my-appointments-container" class="mt-3">
                    <partial name="_AppointmentsListPartial" model="Model" />
                </div>
            </div>

        </div>
    
    
    </div>
</section>



